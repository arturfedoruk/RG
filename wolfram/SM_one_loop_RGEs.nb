Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"kruzhok", "[", 
    RowBox[{"text_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_"}], "}"}], ",", "fontsize_", ",", "r_"}], "]"}], 
   ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"White", ",", 
